APP_ENV=development
APP_BASE_URL=http://localhost:2100
WEB_BIND_HOST=127.0.0.1
WEB_PORT=2100

POSTGRES_DB=swipevault
POSTGRES_USER=swipevault
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://swipevault:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/swipevault

REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=swipevault

SESSION_SECRET=CHANGE_ME_64_HEX_BYTES
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@swipevault.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

ASSET_STORAGE_PATH=/data/assets
CRAWL_DELAY_SECONDS=2
CRAWL_MAX_PAGES=30
CRAWL_MAX_DEPTH=2
DOWNLOAD_MAX_BYTES=26214400

LISTMONK_ENABLED=false
LISTMONK_BASE_URL=
LISTMONK_API_USERNAME=
LISTMONK_API_TOKEN=
AI_PROVIDER=none
